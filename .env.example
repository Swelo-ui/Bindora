# Bindora Environment Configuration Template
# Copy this file to .env and configure your keys

# API Keys for AI narrative generation
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=deepseek/deepseek-v4-flash-0731
GEMINI_API_KEY=your_gemini_api_key_here

# Server Configuration
BINDORA_HOST=127.0.0.1
BINDORA_PORT=5000

# Security Configuration (Production)
BINDORA_DEBUG=False
BINDORA_MAX_CONTENT_LENGTH=33554432
BINDORA_CORS_ORIGINS=http://localhost:5000,http://127.0.0.1:5000

# Database Configuration
DATABASE_URL=sqlite:///data/bindora.db

# AutoDock Vina Binary Path (optional, auto-detected if not set)
# VINA_EXE=/usr/local/bin/vina

# Gunicorn Configuration (Production only)
GUNICORN_WORKERS=2
GUNICORN_TIMEOUT=120
GUNICORN_LOG_LEVEL=info
